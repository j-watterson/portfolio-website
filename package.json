{
  "name": "jonathon-watterson-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/require-node-version.mjs",
    "dev": "vinext dev",
    "dev:node22": "npx --yes --package=node@22.14.0 --call 'npm run dev'",
    "prebuild": "node scripts/require-node-version.mjs",
    "build": "vinext build && node scripts/copy-hosting-metadata.mjs",
    "build:node22": "npx --yes --package=node@22.14.0 --call 'npm run build'",
    "prestart": "node scripts/require-node-version.mjs",
    "start": "vinext start",
    "precheck": "node scripts/require-node-version.mjs",
    "check": "vinext check",
    "check:node22": "npx --yes --package=node@22.14.0 --call 'npm run check'",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "next": "15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.49.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.26",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "5.7.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.2.0",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
