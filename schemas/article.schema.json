{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "description",
    "primaryKeyword",
    "relatedKeywords",
    "category",
    "level",
    "readTime",
    "datePublished",
    "dateModified",
    "canonicalUrl",
    "status",
    "sourceHash",
    "lead",
    "sections",
    "takeaways",
    "sources",
    "requiresVerification",
    "verificationNotes"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "primaryKeyword": {
      "type": "string"
    },
    "relatedKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ]
    },
    "readTime": {
      "type": "string"
    },
    "datePublished": {
      "type": "string"
    },
    "dateModified": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "review"
      ]
    },
    "sourceHash": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "paragraphs",
          "bullets",
          "codeExamples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "codeExamples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "language",
                "code"
              ],
              "properties": {
                "language": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "requiresVerification": {
      "type": "boolean"
    },
    "verificationNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
